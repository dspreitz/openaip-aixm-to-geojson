{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://adhoc-schemas.openaip.net/schemas/aixm-airspace.json",
    "description": "GeoJSON FeatureCollection produced by the AIXM airspace converter. Derived from the schema of openAIP/openaip-aixm-to-geojson, extended by: a feature 'id' carrying the AIXM UUID, MultiPolygon geometries (aggregating airspaces can be disjoint), and the airspace type 'OTHER'.",
    "type": "object",
    "required": ["type", "features"],
    "additionalProperties": false,
    "properties": {
        "type": { "const": "FeatureCollection" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/airspaceFeature" } }
    },
    "$defs": {
        "airspaceFeature": {
            "type": "object",
            "required": ["type", "id", "properties", "geometry"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "Feature" },
                "id": {
                    "type": "string",
                    "description": "The AIXM gml:identifier (UUID) of the airspace - stable across AIRAC cycles.",
                    "pattern": "^[0-9a-fA-F-]{36}$"
                },
                "properties": {
                    "type": "object",
                    "required": ["name", "type", "class", "activity", "upperCeiling", "lowerCeiling", "activatedByNotam"],
                    "additionalProperties": false,
                    "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "type": {
                            "type": "string",
                            "enum": ["CTA", "TMA", "CTR", "ATZ", "DANGER", "PROHIBITED", "RESTRICTED", "WARNING", "AERIAL_SPORTING_RECREATIONAL", "RMZ", "TMZ", "MATZ", "GLIDING_SECTOR", "OTHER"]
                        },
                        "class": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "UNCLASSIFIED"] },
                        "activity": {
                            "type": "string",
                            "enum": ["NONE", "PARACHUTING", "AEROBATICS", "AEROCLUB_AERIAL_WORK", "ULM", "HANG_GLIDING"]
                        },
                        "upperCeiling": { "$ref": "#/$defs/verticalLimit" },
                        "lowerCeiling": { "$ref": "#/$defs/verticalLimit" },
                        "activatedByNotam": { "type": "boolean" }
                    }
                },
                "geometry": {
                    "oneOf": [{ "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/multiPolygon" }]
                }
            }
        },
        "verticalLimit": {
            "type": "object",
            "required": ["value", "unit", "referenceDatum"],
            "additionalProperties": false,
            "properties": {
                "value": { "type": "integer", "minimum": 0 },
                "unit": { "type": "string", "enum": ["FT", "FL"] },
                "referenceDatum": { "type": "string", "enum": ["GND", "STD", "MSL"] }
            }
        },
        "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -90, "maximum": 90 }
            ],
            "items": false
        },
        "linearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
        "polygon": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "Polygon" },
                "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
            }
        },
        "multiPolygon": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "MultiPolygon" },
                "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
                }
            }
        }
    }
}
